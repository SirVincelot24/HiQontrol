QSlider::groove:vertical {
    background-color: black;
    border: 1px solid white;
    width: 10px;
    border-radius: 7px;
}

QSlider::handle:vertical {
    background-color:#1771BF;
    border: 1px solid black;
    width: 20px;
    height: 10px;
    line-height: 20px;
    margin-left: -5px;
    margin-right: -5px;
    border-radius: 7px;
}